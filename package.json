    "version": "1.1.2",
    "author": "Lakmina Egodawattha <kanishkalakmina@gmail.com>",
    "main": "app/background.js",
    "scripts": {
        "dev": "nextron",
        "build": "electron-builder",
        "postinstall": "electron-builder install-app-deps"
