        "electron-serve": "^1.3.0",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.3.9",
        "react-hot-toast": "^2.5.1",
        "react-icons": "^5.4.0",
        "uuid": "^11.0.5"
    },
    "devDependencies": {
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@types/node": "^20.10.6",
